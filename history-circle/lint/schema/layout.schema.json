{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "history-circle/lint/schema/layout.schema.json",
  "title": "역사서클 장면 레이아웃",
  "description": "지도·도식 렌더러가 장면(또는 키 프레임)마다 내보내는 요소 위치. layout_overlap 검사 입력. 좌표는 출력 해상도 픽셀, bbox = [x, y, w, h](왼쪽 위 기준).",
  "type": "object",
  "required": ["canvas", "scenes"],
  "properties": {
    "episode": {"type": "string"},
    "canvas": {
      "type": "object",
      "required": ["w", "h"],
      "properties": {"w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1}}
    },
    "forbidden": {
      "description": "어떤 요소도 들어가면 안 되는 영역(자막띠·제목띠 등). 모든 장면 공통.",
      "type": "array",
      "items": {"$ref": "#/definitions/zone"}
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "elements"],
        "properties": {
          "id": {"type": "string"},
          "t": {"type": "number", "description": "키 프레임 시각(초), 선택"},
          "forbidden": {"type": "array", "items": {"$ref": "#/definitions/zone"}, "description": "이 장면에만 추가되는 금지 영역"},
          "elements": {"type": "array", "items": {"$ref": "#/definitions/element"}}
        }
      }
    }
  },
  "definitions": {
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "zone": {
      "type": "object",
      "required": ["id", "bbox"],
      "properties": {
        "id": {"type": "string"},
        "bbox": {"$ref": "#/definitions/bbox"},
        "allow_kinds": {"type": "array", "items": {"type": "string"}, "description": "이 영역에 들어가도 되는 kind(예: 자막띠에 subtitle)"}
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "kind", "bbox"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["block", "label", "icon", "badge", "arrow", "effect", "subtitle", "title", "other"]},
        "bbox": {"$ref": "#/definitions/bbox"},
        "size_class": {"type": "string", "description": "블록 등급(S/M/L 등). 같은 등급은 크기가 같아야 함"},
        "faction": {"type": "string"},
        "allow_overlap": {"type": "array", "items": {"type": "string"}, "description": "겹쳐도 되는 요소 id(의도한 겹침)"}
      }
    }
  }
}
