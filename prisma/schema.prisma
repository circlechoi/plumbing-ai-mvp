// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 부품 마스터 데이터 (목업 시드 데이터 20~30개)
model Part {
  id        String   @id @default(cuid())
  name      String
  size      String
  material  String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 이 부품과 호환되는 다른 부품들 (다대다 자기참조 관계)
  compatibleWith   Part[] @relation("PartCompatibility")
  compatibleWithRev Part[] @relation("PartCompatibility")

  orders          Order[]
}

// 주문 접수
model Order {
  id               String   @id @default(cuid())
  customerContact  String
  deliveryAddress  String
  quantity         Int
  status           OrderStatus @default(RECEIVED)
  recognizedPartId String?
  recognizedPart   Part?    @relation(fields: [recognizedPartId], references: [id])
  // AI가 최초로 추천한 부품 id 스냅샷 (관리자가 나중에 recognizedPartId를 바꿔도 변하지 않음 — 정확도 분석용)
  aiTopPickId      String?
  confidenceLevel  ConfidenceLevel?
  needsManualCheck Boolean  @default(false)
  // 신뢰도 기반 자동화로 관리자 개입 없이 RECEIVED -> CHECKING까지 자동 진행된 주문인지
  autoProcessed    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recognitionLogs  RecognitionLog[]
}

// 앱 전역 설정 (단일 row만 존재하는 싱글턴)
model Settings {
  id                 Int      @id @default(1)
  autoApproveEnabled Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

enum OrderStatus {
  RECEIVED
  CHECKING
  COMPLETED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

// AI 인식 로그 (정확도 분석용)
model RecognitionLog {
  id            String   @id @default(cuid())
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  rawImageUrl   String
  aiResponseJson String
  // 비용 분석용 (실제 Anthropic API 응답의 usage 값)
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  createdAt     DateTime @default(now())
}
