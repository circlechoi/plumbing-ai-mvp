# Prisma SQLite 데이터베이스 (로컬 파일, 별도 설정 불필요)
DATABASE_URL="file:./dev.db"

# Anthropic Claude API 키 (https://console.anthropic.com 에서 발급)
# Vision 인식 기능(/api/recognize)에 필요합니다.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"

# 관리자 대시보드(/admin) 접근용 비밀번호 (비워두면 게이트가 비활성화됨)
# 배포 시 반드시 강력한 값으로 교체하세요 (로컬 데모용 기본값을 그대로 쓰지 마세요)
ADMIN_PASSWORD="change-me"

# 업로드된 이미지 저장 경로 (선택 사항)
# 비워두면 public/uploads에 저장됩니다. Railway 등 배포 환경에서는 영구 볼륨 경로로
# 설정해야 재배포 후에도 이미지가 유지됩니다 (예: /data/uploads).
UPLOADS_DIR=""
